[Unit]
Description=XWADDA.KE Node service
After=network.target mongod.service
Requires=mongod.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/xwadda
EnvironmentFile=/var/www/xwadda/.env
Environment=PATH=/home/deploy/.nvm/versions/node/v24.21.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/home/deploy/.nvm/versions/node/v24.21.0/bin/node /var/www/xwadda/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
